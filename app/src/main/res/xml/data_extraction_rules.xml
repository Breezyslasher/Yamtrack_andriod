<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): exclude the credential-bearing DataStore from
     cloud backup and device-to-device transfer so the API token can't be
     exfiltrated via backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
